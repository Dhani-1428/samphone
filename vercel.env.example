# Import into Vercel: Project → Settings → Environment Variables → Import .env
# Copy to vercel.env, fill in real values, then import (see docs/VERCEL.md).
# DO NOT commit vercel.env — it may contain secrets.
# Public VITE_* must match the Expo app (EAS) so checkout, login, and banners stay in sync.
# Full stack map: docs/STACK.md — VPS secrets template: samphone.cloud.env.example

# --- WooCommerce (server-side — optional legacy /api/woocommerce) ---
WOOCOMMERCE_STORE_URL=https://www.samphone.pt
WOOCOMMERCE_CONSUMER_KEY=ck_your_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_secret_here

# --- Admin pricing API (optional) ---
PRICING_ADMIN_TOKEN=your-long-random-admin-token
PRICING_ADMIN_EMAIL=admin@samphone.pt

# --- Storefront (VITE_* — baked into build; same as app public env) ---
# App: EXPO_PUBLIC_BACKEND_URL / EXPO_PUBLIC_API_URL = https://samphone.cloud
VITE_SAMPHONE_CLOUD_ORIGIN=https://samphone.cloud
VITE_SAMPHONE_API_URL=/cloud-api
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc2FtcGhvbmUuY2xvdWQk
VITE_CLERK_FRONTEND_API=https://clerk.samphone.cloud
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51TsRh0IFNHslwSxObrZX8Fx7eneUwyjSeSj0QmbJJKB39lmLDrwNzGOjfk646Y4hacs0jyT9bJSPpGuk4hlojYTy00Ir71HQaq
VITE_WOOCOMMERCE_STORE_URL=https://www.samphone.pt
VITE_WOOCOMMERCE_CURRENCY_SYMBOL=€
VITE_WOO_API_BASE=/api/woocommerce
VITE_PRICING_API_URL=/api

# --- Optional category slug overrides ---
# VITE_WOO_EXTRA_PHONE_CATEGORY_SLUGS=celulares,telemoveis
# VITE_WOO_EXTRA_TABLET_CATEGORY_SLUGS=samsung-tablets,ipad

# NOTE: JWT, Clerk sk_, Stripe sk_, MySQL, SMTP, DPD belong on samphone.cloud VPS only — not in Vercel/WordPress JS.
