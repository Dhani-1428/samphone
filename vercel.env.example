# Import into Vercel: Project → Settings → Environment Variables → Import .env
# Copy to vercel.env, fill in real values, then import (see docs/VERCEL.md).
# DO NOT commit vercel.env — it contains secrets.

# --- WooCommerce (server-side — powers /api/woocommerce on Vercel) ---
WOOCOMMERCE_STORE_URL=https://www.samphone.pt
WOOCOMMERCE_CONSUMER_KEY=ck_your_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_secret_here

# --- Admin pricing API (optional) ---
PRICING_ADMIN_TOKEN=your-long-random-admin-token
PRICING_ADMIN_EMAIL=admin@samphone.pt

# --- Storefront (VITE_* — baked into build at deploy time) ---
VITE_WOOCOMMERCE_STORE_URL=https://www.samphone.pt
VITE_WOOCOMMERCE_CURRENCY_SYMBOL=€
VITE_WOO_API_BASE=/api/woocommerce
VITE_PRICING_API_URL=/api

# --- Optional category slug overrides ---
# VITE_WOO_EXTRA_PHONE_CATEGORY_SLUGS=celulares,telemoveis
# VITE_WOO_EXTRA_TABLET_CATEGORY_SLUGS=samsung-tablets,ipad
