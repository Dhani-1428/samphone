# Import into Vercel: Project → Settings → Environment Variables → Import .env
# Copy to vercel.env, fill in real values, then import (see docs/VERCEL.md).
# DO NOT commit vercel.env. Public VITE_* only on the website — secrets stay on samphone.cloud.
# Full stack map: docs/STACK.md — VPS secrets template: samphone.cloud.env.example
#
# Do NOT import backend/.env, artifacts/api-server/.env, or samphone.cloud.env.example.
# Those files set PORT / JWT / CORS / DB and will fail or misconfigure the website build.
# On Vercel, delete PORT, JWT_SECRET, CORS_ALLOW_ORIGINS, USE_MEMORY, ADMIN_PASSWORD, ck_/cs_, sk_.

# --- Storefront (VITE_* — baked into build; same as app public env) ---
# App: EXPO_PUBLIC_BACKEND_URL / EXPO_PUBLIC_API_URL = https://samphone.cloud
VITE_SAMPHONE_CLOUD_ORIGIN=https://samphone.cloud
# Must be /cloud-api (Vercel rewrite) or https://samphone.cloud/api — not the bare origin.
VITE_SAMPHONE_API_URL=/cloud-api
# Optional until you attach a custom domain. Preview works on *.vercel.app without this.
VITE_SITE_URL=https://samphone.eu
SITE_URL=https://samphone.eu
NEXT_PUBLIC_SITE_URL=https://samphone.eu
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc2FtcGhvbmUuZXUk
VITE_CLERK_FRONTEND_API=https://clerk.samphone.eu
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51TsRh0IFNHslwSxObrZX8Fx7eneUwyjSeSj0QmbJJKB39lmLDrwNzGOjfk646Y4hacs0jyT9bJSPpGuk4hlojYTy00Ir71HQaq
VITE_WOOCOMMERCE_STORE_URL=https://www.samphone.eu
VITE_WOOCOMMERCE_CURRENCY_SYMBOL=€

# NOTE: JWT, Clerk sk_, Stripe sk_, Woo ck_/cs_, MySQL, SMTP, DPD belong on samphone.cloud only.
# Do not set NODE_OPTIONS on Vercel — it can make /cloud-api functions return 502.
