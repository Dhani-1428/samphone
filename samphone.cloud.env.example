# Production API env for samphone.cloud / VPS
# Copy to the server (e.g. /etc/samphone/cloud.env). Do NOT commit filled secrets.
# Do not wrap values in quotes. Fill DB/SMTP/secrets; keep names exactly as below.
# Website/Vercel only need public VITE_* — see vercel.env.example and docs/STACK.md.

ENVIRONMENT=production
USE_MEMORY=0
USE_CATALOG_MYSQL=1
USE_APP_MYSQL=1
USE_WOOCOMMERCE=0
ENABLE_HSTS=1
BACKEND_PORT=8006
PUBLIC_API_URL=https://samphone.cloud
SITE_URL=https://www.samphone.pt
CORS_ALLOW_ORIGINS=https://www.samphone.pt,https://samphone.pt,https://staging.samphone.pt,https://samphone.cloud
JWT_SECRET=<long random secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAIL=samphone.pt@gmail.com
ADMIN_PASSWORD=<strong password>
CLERK_ADMIN_EMAIL=samphone.pt@gmail.com
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_ISSUER=https://clerk.samphone.cloud
DB_HOST=<mysql-host>
DB_PORT=3306
DB_USER=<user>
DB_PASSWORD=<password>
DB_NAME=<name>
CATALOG_MYSQL_HOST=<same-or-catalog-host>
CATALOG_MYSQL_PORT=3306
CATALOG_MYSQL_DATABASE=<catalog-db>
CATALOG_MYSQL_USER=<user>
CATALOG_MYSQL_PASSWORD=<password>
CATALOG_MYSQL_POOL_SIZE=2
WP_TABLE_PREFIX=wp_
B2C_DEFAULT_MARKUP=1.0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail>
SMTP_PASSWORD=<app-password>
EMAIL_FROM=Samphone <samphone.pt@gmail.com>
SUPPORT_EMAIL=support@samphone.pt
ADMIN_NOTIFY_EMAIL=admin@samphone.pt
STRIPE_PUBLISHABLE_KEY=pk_live_51TsRh0IFNHslwSxObrZX8Fx7eneUwyjSeSj0QmbJJKB39lmLDrwNzGOjfk646Y4hacs0jyT9bJSPpGuk4hlojYTy00Ir71HQaq
STRIPE_SECRET_KEY=sk_live_...
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
SAMPHONE_STORE_URL=https://www.samphone.pt
BANNER_FETCH_TIMEOUT=8
BANNER_CACHE_TTL=90

# Email (Gmail SMTP — all customer/admin mail from API, not WordPress)
# ADMIN_NOTIFY_EMAIL gets public signups + B2B applications (see docs/B2B.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail>
SMTP_PASSWORD=<16-char Gmail App Password>
EMAIL_FROM=Samphone <samphone.pt@gmail.com>
SUPPORT_EMAIL=support@samphone.pt
ADMIN_NOTIFY_EMAIL=samphone.pt@gmail.com
ENABLE_ABANDONED_CART_EMAILS=1
CART_ABANDON_HOURS=24

# DPD (shipment service — same as app; restart after fill)
DPD_BASE_URL=https://qabusiness.dpd.pt/api/v1/pt
DPD_USERNAME=
DPD_PASSWORD=
DPD_CLIENT_ID=
DPD_CLIENT_SECRET=
DPD_SUB_ACCOUNT_CODE=031683
DPD_LABEL_STORAGE_DIR=storage/labels
DPD_SENDER_NAME=Samphone
DPD_SENDER_EMAIL=samphone.pt@gmail.com
DPD_SENDER_MOBILE=
DPD_SENDER_MOBILE_CODE=351
DPD_SHIPPER_COUNTRY=PT
