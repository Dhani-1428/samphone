# Local FastAPI for the Samphone website (same contract as the Expo app API).
# Copy to backend/.env — never commit secrets.

ENVIRONMENT=development
USE_MEMORY=1
USE_CATALOG_MYSQL=0
USE_APP_MYSQL=0
USE_WOOCOMMERCE=0
BACKEND_PORT=8006
PUBLIC_API_URL=http://127.0.0.1:8006
SITE_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme-admin
REQUIRE_LOGIN_MFA=0

# Optional — connect to the same Hostinger MySQL as the app (see samphone.cloud.env.example)
# USE_MEMORY=0
# USE_CATALOG_MYSQL=1
# USE_APP_MYSQL=1
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# CATALOG_MYSQL_HOST=
# CATALOG_MYSQL_USER=
# CATALOG_MYSQL_PASSWORD=
# CATALOG_MYSQL_DATABASE=
# WP_TABLE_PREFIX=wp_
# CLERK_SECRET_KEY=
# CLERK_JWT_ISSUER=https://clerk.samphone.cloud
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Samphone <samphone.pt@gmail.com>
# ADMIN_NOTIFY_EMAIL=samphone.pt@gmail.com
