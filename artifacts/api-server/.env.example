# API server — server-side secrets only (never VITE_* / never commit .env)

PORT=8080

# WooCommerce REST (read-only keys recommended)
WOOCOMMERCE_STORE_URL=https://www.samphone.pt
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx

# Customer pricing admin routes
DATABASE_URL=
PRICING_ADMIN_TOKEN=change-me-long-random-secret
PRICING_ADMIN_EMAIL=admin@samphone.pt

# CORS: comma-separated storefront origins (production)
CORS_ORIGINS=https://www.samphone.pt,https://samphone.pt,http://localhost:5173
