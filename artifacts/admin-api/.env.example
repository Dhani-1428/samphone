# Server
NODE_ENV=development
PORT=8090
ADMIN_API_BASE_URL=http://127.0.0.1:8090

# Database (see lib/admin-db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/samphone_admin

# JWT (Step 5)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (Step 10)
# REDIS_URL=redis://127.0.0.1:6379

# CORS — admin dashboard origin
CORS_ORIGIN=http://localhost:3001

# CSRF cookie name (dashboard)
CSRF_COOKIE_NAME=admin_csrf

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# File uploads / CDN (Step 10)
# UPLOAD_MAX_MB=10
# CDN_BASE_URL=
