# Copy to `artifacts/samphone/.env.local` — PUBLIC values only (bundled into the browser).
# Same public stack as the Expo app (EAS). NEVER put sk_, JWT, DB, SMTP, OpenAI, or DPD here.
# See docs/STACK.md and samphone.cloud.env.example for VPS-only secrets.

# Local website API (this repo)
VITE_SAMPHONE_API_URL=/cloud-api
# Production: https://samphone.cloud
# Local FastAPI: http://127.0.0.1:8006
VITE_SAMPHONE_CLOUD_ORIGIN=https://samphone.cloud

# Clerk (publishable — EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc2FtcGhvbmUuY2xvdWQk
VITE_CLERK_FRONTEND_API=https://clerk.samphone.cloud

# Stripe (publishable — EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY; secret only on API)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51TsRh0IFNHslwSxObrZX8Fx7eneUwyjSeSj0QmbJJKB39lmLDrwNzGOjfk646Y4hacs0jyT9bJSPpGuk4hlojYTy00Ir71HQaq

# Store / display
VITE_WOOCOMMERCE_STORE_URL=https://www.samphone.pt
VITE_WOOCOMMERCE_CURRENCY_SYMBOL=€

# Legacy Woo REST proxy (optional; production catalog is MySQL via samphone.cloud)
# VITE_WOO_API_BASE=/api/woocommerce
# VITE_PRICING_API_URL=/api
# VITE_PRICING_API_PROXY=http://127.0.0.1:8080

# Optional category slug overrides
# VITE_WOO_EXTRA_PHONE_CATEGORY_SLUGS=celulares,telemoveis
# VITE_WOO_EXTRA_TABLET_CATEGORY_SLUGS=samsung-tablets,ipad

# DANGEROUS — do not use in production
# VITE_WOO_USE_CLIENT_CREDENTIALS=true
