# Copy to `artifacts/samphone/.env.local` (same folder as this file) and fill in.
# Never commit `.env.local`. Vite `envDir` is this app folder, so root-level `.env` alone is not used for `VITE_*` here.
# Keys are read at build/dev time only — there is no in-browser “connect” form.
# WooCommerce → Settings → Advanced → REST API (read-only keys are enough for catalog).
# With keys set, “All categories” and /category/:slug load real categories and products from the store.

VITE_WOOCOMMERCE_STORE_URL=https://samphone.pt
VITE_WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
VITE_WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx

# Optional: comma-separated WooCommerce category slugs for retail phones/tablets if they differ from defaults.
# Example: VITE_WOO_EXTRA_PHONE_CATEGORY_SLUGS=celulares,telemoveis
# VITE_WOO_EXTRA_TABLET_CATEGORY_SLUGS=samsung-tablets,ipad

# Optional: shown before the price string from WooCommerce
# VITE_WOOCOMMERCE_CURRENCY_SYMBOL=€

# Local dev: proxy WooCommerce through Vite to avoid browser CORS errors.
# Set to "true" only when developing; production should use a server-side proxy or allowlisted CORS on WordPress.
# VITE_USE_WOO_PROXY=true
# Optional if different from STORE_URL:
# VITE_WOO_PROXY_TARGET=https://samphone.pt

# Customer-specific pricing API (dev: run api-server on port 8080)
# VITE_PRICING_API_URL=/api
# VITE_PRICING_API_PROXY=http://127.0.0.1:8080
# VITE_PRICING_ADMIN_TOKEN=dev-admin-secret
