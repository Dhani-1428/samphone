# Copy to `artifacts/samphone/.env.local` — PUBLIC values only (bundled into the browser).
# NEVER put API keys, consumer secrets, or admin tokens here.
#
# WooCommerce credentials belong on the API server:
#   artifacts/api-server/.env  →  WOOCOMMERCE_STORE_URL, WOOCOMMERCE_CONSUMER_KEY, WOOCOMMERCE_CONSUMER_SECRET
#
# Admin pricing token belongs on the API server only:
#   PRICING_ADMIN_TOKEN  (enter at /admin/pricing login — stored in sessionStorage, not in env)

# Optional: display / marketing (public)
VITE_WOOCOMMERCE_STORE_URL=https://www.samphone.pt
VITE_WOOCOMMERCE_CURRENCY_SYMBOL=€

# WooCommerce proxy base (default — credentials added server-side)
# VITE_WOO_API_BASE=/api/woocommerce

# Pricing + Woo proxy target in dev (Vite → api-server :8080)
# VITE_PRICING_API_URL=/api
# VITE_PRICING_API_PROXY=http://127.0.0.1:8080

# Optional category slug overrides (public, non-secret)
# VITE_WOO_EXTRA_PHONE_CATEGORY_SLUGS=celulares,telemoveis
# VITE_WOO_EXTRA_TABLET_CATEGORY_SLUGS=samsung-tablets,ipad

# DANGEROUS — do not use in production (exposes keys in browser DevTools)
# VITE_WOO_USE_CLIENT_CREDENTIALS=true
