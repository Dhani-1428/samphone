{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/cloud-api",
      "destination": "/api/cloud"
    },
    {
      "source": "/cloud-api/:path*",
      "destination": "/api/cloud?path=:path*"
    },
    {
      "source": "/:path((?!api/|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/cloud-api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
