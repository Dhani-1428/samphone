{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/samphone run build && node scripts/prepare-vercel-public.mjs && node scripts/sync-vercel-api.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/woocommerce/[...path].ts": {
      "maxDuration": 30
    },
    "api/woocommerce/status.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/cloud-api",
      "destination": "https://samphone.cloud/api"
    },
    {
      "source": "/cloud-api/:path*",
      "destination": "https://samphone.cloud/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/cloud-api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
